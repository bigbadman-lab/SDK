{
  "name": "sdk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "sdk:register": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types services/transaction-builder/src/sdk-register-cli.ts",
    "sdk:status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types services/transaction-builder/src/sdk-status-cli.ts",
    "sdk:activate-rewards": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types services/transaction-builder/src/sdk-activate-cli.ts",
    "sdk:activate-launches": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types services/transaction-builder/src/sdk-launch-cli.ts",
    "sdk:rewards-status": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types services/transaction-builder/src/sdk-rewards-status-cli.ts",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test lib/auth/*.test.ts",
    "test:blueprint": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test lib/blueprint/*.test.ts lib/builder/*.test.ts lib/library/*.test.ts lib/api/*.test.ts lib/launch/*.test.ts lib/wallet/*.test.ts lib/rewards/*.test.ts",
    "test:builder": "npm test --prefix services/transaction-builder"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-solana": "^1.8.24",
    "@solana/kit": "8.5.0",
    "@solana/web3.js": "^1.99.0",
    "@wallet-standard/app": "1.1.0",
    "bs58": "^6.0.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
