{
  "name": "sdk-transaction-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit --pretty false",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/**/*.test.ts"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "4.2.0",
    "@solana/kit": "8.5.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
