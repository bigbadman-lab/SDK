{
  "name": "sdk-universal-client",
  "version": "0.1.0",
  "description": "Universal client for the SDK execution API. This package is not published to NPM.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
