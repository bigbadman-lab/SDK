# Recognized configuration. Leave secrets blank.
# The public site builds and runs without any of these values.
# Do not put real keys in this file.

# Public origin, including scheme, with no path. Leave blank until a real domain exists.
NEXT_PUBLIC_APP_URL=

# Solana cluster for wallet sign-in: mainnet-beta, devnet, or testnet.
# Unset or unrecognized values use mainnet-beta.
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

APP_SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
NEXT_PUBLIC_REOWN_PROJECT_ID=
OPENAI_API_KEY=
HELIUS_API_KEY=
HELIUS_RPC_URL=
BIRDEYE_API_KEY=
PINATA_JWT=
PINATA_GATEWAY_DOMAIN=
# Launch artwork uses the private Supabase Storage bucket launch-artwork,
# created by 20261019220000_phase_05b_launch_preparation.sql.
# Pinata pins the image and metadata. Do not put these values in browser code.
# Render origin for the transaction builder, including https and no path.
# Server-only. Leave blank until Render assigns the service URL.
TX_BUILDER_URL=
TX_BUILDER_SECRET=
# Server-only 32-byte key, encoded as 64 hex characters. Required before a signed
# launch can be stored for recovery. Leave blank until that key is generated.
# Do not put it in browser code, on the transaction builder, or on the rewards worker.
LAUNCH_WIRE_KEY=
# Public platform fee beneficiary. It must stay this deployer address.
# Not a secret, and not a second treasury.
SDK_PLATFORM_FEE_WALLET=DLhNy5Y33LrSoszV4cG3dEfcXTTmnRMDDUgFLMpt7zwC

# Optional. Server-only wallet allowed to perform operator actions.
# Leave blank until an operator is provisioned.
OPERATOR_WALLET_ADDRESS=
# TREST deployer signing belongs only on the separate rewards worker.
# Do not set TREST_DEPLOYER_PRIVATE_KEY in this file, on Vercel, or on the transaction builder.

# Server-only pepper for API key digests. At least 32 characters.
# Key hashes cannot be looked up without it. Rotating it invalidates existing keys.
# Leave blank until API keys are enabled. Do not commit a real value.
API_KEY_PEPPER=
